{
  "name": "brain-rush",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "brain-rush",
      "version": "0.0.0",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.9.3"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "apps/api": {
      "name": "@brain-rush/api",
      "version": "0.0.0",
      "dependencies": {
        "@brain-rush/gamespec": "*",
        "@brain-rush/prompts": "*"
      }
    },
    "apps/web": {
      "name": "@brain-rush/web",
      "version": "0.0.0"
    },
    "node_modules/@brain-rush/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@brain-rush/engine": {
      "resolved": "packages/engine",
      "link": true
    },
    "node_modules/@brain-rush/gamespec": {
      "resolved": "packages/gamespec",
      "link": true
    },
    "node_modules/@brain-rush/prompts": {
      "resolved": "packages/prompts",
      "link": true
    },
    "node_modules/@brain-rush/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "node_modules/zod": {
      "version": "4.6.7",
      "resolved": "https://registry.npmjs.org/zod/-/zod-4.6.7.tgz",
      "integrity": "sha512-g8W2D2kU6a8untc053fX1uVBKzM7yqAxW/3zwk83+6RyF2+SKOuV+c0wBDhUwzV1PaGapmZH+rmcUzPf+3CGwg==",
      "license": "MIT",
      "funding": {
        "url": "https://github.com/sponsors/colinhacks"
      }
    },
    "packages/engine": {
      "name": "@brain-rush/engine",
      "version": "0.0.0"
    },
    "packages/gamespec": {
      "name": "@brain-rush/gamespec",
      "version": "0.0.0",
      "dependencies": {
        "zod": "^4.6.7"
      }
    },
    "packages/prompts": {
      "name": "@brain-rush/prompts",
      "version": "0.0.0"
    }
  }
}
